# Copy to .env and fill in. Never commit .env.

# --- Eval LLM ---
ANTHROPIC_API_KEY=
EVAL_MODEL=claude-haiku-5-5

# --- Gateway ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8800
GATEWAY_CONFIG=config/dev.yaml
GATEWAY_POLICY=policies/default.yaml
GATEWAY_MODE=provenance            # pass_through | grants_only | sequence_rules | provenance | session_taint
APPROVAL_TIMEOUT_SECONDS=60
VAULT_KEY=                         # generated locally; used to encrypt stored credentials

# --- Stores (M3) ---
STORE_BACKEND=memory               # memory | redis_postgres
DATABASE_URL=sqlite:///./data/gateway.db
REDIS_URL=redis://127.0.0.1:6379/0

# --- Dashboard (M3) ---
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=

# --- Local machine (external SSD) ---
# export UV_CACHE_DIR="/Volumes/thanu's T7/.cache/uv"
# export UV_LINK_MODE=copy
